<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OmniAI</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;
  background:#0b1020;
  color:white;
}
header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px;
  border-bottom:1px solid #26304a;
}
.logo{font-size:25px;font-weight:bold}
.login{
  padding:10px 18px;
  border:0;
  border-radius:10px;
}
.hero{text-align:center;padding:70px 20px 40px}
.hero h1{font-size:45px;margin-bottom:15px}
.hero span{color:#7c8cff}
.hero p{color:#b8bfd3;font-size:18px;margin-bottom:30px}

.chatbox{
  max-width:650px;
  margin:auto;
  background:#151c31;
  padding:12px;
  border:1px solid #303b5c;
  border-radius:18px;
  display:flex;
  gap:10px;
}
.chatbox input{
  flex:1;
  background:transparent;
  border:0;
  outline:none;
  color:white;
  font-size:16px;
  padding:12px;
}
.chatbox button{
  border:0;
  border-radius:12px;
  padding:12px 20px;
  background:#6875ff;
  color:white;
}

.tools{
  max-width:900px;
  margin:40px auto;
  padding:20px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:18px;
}
.card{
  background:#151c31;
  border:1px solid #303b5c;
  border-radius:18px;
  padding:25px;
}
.card h2{margin-bottom:10px}
.card p{color:#aeb6cc}

footer{
  text-align:center;
  padding:30px;
  color:#8992aa;
}
</style>
</head>

<body>

<header>
  <div class="logo">🤖 OmniAI</div>
  <button class="login">Login</button>
</header>

<section class="hero">
  <h1>Welcome to <span>OmniAI</span></h1>
  <p>Your all-in-one AI platform</p>

  <div class="chatbox">
    <input type="text" placeholder="Ask OmniAI anything...">
    <button>Send</button>
  </div>
</section>

<section class="tools">

  <div class="card">
    <h2>💬 AI Chat</h2>
    <p>Chat with your AI assistant.</p>
  </div>

  <div class="card">
    <h2>🖼️ AI Image</h2>
    <p>Create images from your ideas.</p>
  </div>

  <div class="card">
    <h2>🎬 AI Video</h2>
    <p>Create videos with AI.</p>
  </div>

  <div class="card">
    <h2>🌐 Languages</h2>
    <p>Use OmniAI in multiple languages.</p>
  </div>

</section>

<footer>
  © 2026 OmniAI — AI for everyone
</footer>

</body>
</html>
